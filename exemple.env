# Copy to .env locally. This file contains placeholders only.
# These two values are PUBLIC configuration, protected by Supabase RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Server/CLI only. Never included in frontend builds.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_SUPABASE_AND_GITHUB_SECRETS
SUPABASE_ACCESS_TOKEN=SET_ONLY_LOCALLY
GITHUB_DEPLOY_TOKEN=SET_ONLY_IN_SUPABASE_SECRETS
# Supabase Edge Function settings
GITHUB_REPOSITORY=NeurAI-source/site-farmacia-droga-vida
SITE_ORIGIN=https://neurai-source.github.io

# Cloudflare deployment: keep actual credentials in GitHub Actions Secrets
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_PAGES_DEPLOY_TOKEN
SITE_ORIGINS=https://YOUR_SITE_DOMAIN
